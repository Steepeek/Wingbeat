# Ассеты собираются из клиента и уезжают в релизный архив, а не в историю.
# PNG не сжимается (7 496 975 -> 7 512 095 после zlib), поэтому каждая
# пересборка добавляла бы мегабайты всем, кто клонирует репозиторий.
/assets/

# Внутренние инструменты сборки ассетов. В открытый репозиторий не едут.
/tools/private/

# Исходники оформления: тяжёлые PNG от генератора и рабочие материалы
# бренда. В релиз едут уже нарезанные и уменьшенные, а оригиналы стоит
# хранить отдельно — перегенерировать их точь-в-точь нельзя.
/art/
/brand/
/designe/

# Сборка
/build/
/dist/
# Собранный установщик — 74 МБ на каждую версию. Он едет в релизы
# GitHub, а не в историю: иначе репозиторий распухнет от бинарников,
# которые никому не нужны после выхода следующей версии.
/installer/out/
__pycache__/
*.pyc
