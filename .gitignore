# Ассеты собираются из клиента и уезжают в релизный архив, а не в историю.
# PNG не сжимается (7 496 975 -> 7 512 095 после zlib), поэтому каждая
# пересборка добавляла бы мегабайты всем, кто клонирует репозиторий.
/assets/

# Инструменты сборки с ключами от клиентских паков. Публиковать нельзя:
# сервер сменит ключ патчем, и метр сломается у всех разом.
/tools/private/

# Исходники оформления: тяжёлые PNG от генератора. В релиз едут уже
# нарезанные и уменьшенные, а оригиналы стоит хранить отдельно —
# перегенерировать их точь-в-точь нельзя.
/art/
/designe/

# Сборка
/build/
/dist/
__pycache__/
*.pyc
